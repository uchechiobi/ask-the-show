# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml - it's gitignored.
#
# The deployed Day 6 app (scripts/app.py) uses agent.py, which calls no
# external API and needs NO secrets at all - this file can stay empty.
# It exists to document the pattern for if you wire in llm_agent.py
# (Anthropic API) later: on Streamlit Community Cloud, paste the same
# key=value pairs into your app's "Secrets" box under Advanced settings
# instead of using a local .env file.

# ANTHROPIC_API_KEY = "your_anthropic_api_key_here"
